{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": [
              "${halo_python}",
              "${CLAUDE_PLUGIN_ROOT}/hooks/log_write.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "args": [
              "${halo_python}",
              "${CLAUDE_PLUGIN_ROOT}/hooks/rg_todos.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
